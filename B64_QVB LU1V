<div class="remain">

    <div class="redirect">

        <style>
            .license-page{
                direction:rtl;
                width:100%;
                min-height:100vh;
                box-sizing:border-box;
                display:flex;
                align-items:center;
                justify-content:center;
                padding:30px 18px;
                background:#f5f6f8;
                font-family:Tahoma,Arial,sans-serif;
            }

            .license-card{
                width:100%;
                max-width:620px;
                background:#fff;
                border:1px solid #e8e8e8;
                border-radius:24px;
                padding:45px 35px;
                text-align:center;
                box-sizing:border-box;
                box-shadow:0 18px 55px rgba(0,0,0,.09);
            }

            .license-warning{
                width:78px;
                height:78px;
                margin:0 auto 24px;
                border-radius:50%;
                background:#fff0f0;
                display:flex;
                align-items:center;
                justify-content:center;
            }

            .license-warning svg{
                width:40px;
                height:40px;
                fill:none;
                stroke:#e53935;
                stroke-width:1.8;
                stroke-linecap:round;
                stroke-linejoin:round;
            }

            .license-title{
                margin:0 0 15px;
                color:#202124;
                font-size:25px;
                font-weight:700;
                line-height:1.6;
            }

            .license-text{
                margin:0 auto;
                max-width:500px;
                color:#6b7078;
                font-size:15px;
                line-height:2;
            }

            .license-link{
                color:#e53935;
                text-decoration:none;
                font-weight:700;
            }

            .license-link:hover{
                text-decoration:underline;
            }

            .license-info{
                margin-top:28px;
                padding:15px 17px;
                border-radius:13px;
                background:#f8f9fa;
                border:1px solid #eceef0;
                color:#70757c;
                font-size:13px;
                line-height:1.8;
            }

            .license-bottom{
                margin-top:23px;
                color:#a0a4aa;
                font-size:11px;
            }

            @media(max-width:600px){

                .license-page{
                    padding:18px 12px;
                }

                .license-card{
                    padding:35px 20px;
                    border-radius:20px;
                }

                .license-warning{
                    width:68px;
                    height:68px;
                }

                .license-warning svg{
                    width:34px;
                    height:34px;
                }

                .license-title{
                    font-size:21px;
                }

                .license-text{
                    font-size:14px;
                }
            }

            .domains{
                display:none!important;
            }
        </style>


        <div class="license-page">

            <div class="license-card">

                <div class="license-warning">

                    <svg viewBox="0 0 24 24">

                        <path d="M12 3L2.8 20h18.4L12 3z"></path>

                        <path d="M12 9v5"></path>

                        <path d="M12 17.5h.01"></path>

                    </svg>

                </div>


                <h2 class="license-title">
                    عفواً! هذا القالب غير مرخص
                </h2>


