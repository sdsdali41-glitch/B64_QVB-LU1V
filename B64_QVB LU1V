                    يرجى التواصل مع مالك القالب لتفعيل الترخيص.

                </div>


                <div class="license-bottom">
                    نظام حماية وترخيص القالب
                </div>

            </div>

        </div>


        <!-- مهم جداً: لا تحذف هذه القائمة -->
        <ul class="domains">

            <li>google.com</li>

        </ul>

    </div>

</div>
